<UserControl x:Class="CMSBuilder.Views.Dashboard.FilterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280">

    <Border Style="{StaticResource CardBorder}" Padding="20">
        <StackPanel>
            <TextBlock Text="Фильтры"
                       Style="{StaticResource Heading2Text}"
                       Margin="0,0,0,16" />

            <TextBlock Text="Роль" Style="{StaticResource LabelText}" />
            <ComboBox Margin="0,0,0,14">
                <ComboBoxItem Content="Все" IsSelected="True" />
                <ComboBoxItem Content="Владелец" />
                <ComboBoxItem Content="Администратор" />
                <ComboBoxItem Content="Модератор" />
                <ComboBoxItem Content="Просмотр" />
            </ComboBox>

            <TextBlock Text="Сортировка" Style="{StaticResource LabelText}" />
            <ComboBox Margin="0,0,0,20">
                <ComboBoxItem Content="По дате создания" IsSelected="True" />
                <ComboBoxItem Content="По названию" />
            </ComboBox>

            <Button Content="Применить" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
            <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </Border>
</UserControl>
