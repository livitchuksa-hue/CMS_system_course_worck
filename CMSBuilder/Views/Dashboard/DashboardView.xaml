<UserControl x:Class="CMSBuilder.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="72" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CMS Builder" Style="{StaticResource Heading2Text}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBox Grid.Column="1" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Новый сайт" Style="{StaticResource PrimaryButton}" Width="130" Margin="0,0,10,0"
                            Command="{Binding CreateWebsiteCommand}" />
                    <Button x:Name="ProfileButton" Content="Аккаунт" Style="{StaticResource SecondaryButton}" Width="100"
                            Command="{Binding OpenAccountCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Popup IsOpen="{Binding Account.IsOpen}" PlacementTarget="{Binding ElementName=ProfileButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource CardBorder}" Padding="16" MinWidth="240">
                <StackPanel DataContext="{Binding Account}">
                    <TextBlock Text="Аккаунт" Style="{StaticResource Heading3Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentUserLogin, StringFormat=Логин: {0}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding CurrentUserEmail, StringFormat=Email: {0}}" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                    <Button Content="Выйти" Style="{StaticResource PrimaryButton}" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Border>
        </Popup>

        <ScrollViewer Style="{StaticResource AppScrollViewer}" Padding="24"
                      Background="{StaticResource WorkspaceBrush}">
            <ItemsControl ItemsSource="{Binding Websites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,20">
                            <Border Width="300" Height="220" Style="{StaticResource CardBorder}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="{StaticResource SurfaceMutedBrush}" />
                                    <StackPanel Grid.Row="1" Margin="14">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Heading3Text}" />
                                        <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                        <Border Style="{StaticResource AccentBadge}" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Role}" Style="{StaticResource AccentBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
