<UserControl x:Class="CMSBuilder.Views.Dashboard.WebsiteCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="220">

    <Border Style="{StaticResource CardBorder}"
            Padding="0"
            Cursor="Hand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="Preview"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" Margin="14">
                <TextBlock Text="Название сайта"
                           Style="{StaticResource Heading3Text}" />
                <TextBlock Text="ID: 1241"
                           Style="{StaticResource CaptionText}"
                           Margin="0,6,0,0" />
                <Border Style="{StaticResource AccentBadge}" Margin="0,10,0,0">
                    <TextBlock Text="Владелец" Style="{StaticResource AccentBadgeText}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
