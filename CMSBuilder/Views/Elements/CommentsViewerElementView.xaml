<UserControl x:Class="CMSBuilder.Views.Elements.CommentsViewerElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="140" MinWidth="280">
    <Border Style="{StaticResource CardBorder}" Padding="12">
        <StackPanel>
            <TextBlock Text="{Binding Properties.Text, FallbackValue=Комментарии}"
                       Style="{StaticResource Heading3Text}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="Только просмотр. Комментарии из БД отображаются на опубликованном сайте." />
            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource CaptionText}" Text="Просмотр (без формы отправки)" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
