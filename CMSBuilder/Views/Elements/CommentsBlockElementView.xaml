<UserControl x:Class="CMSBuilder.Views.Elements.CommentsBlockElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="140"
             MinWidth="280">
    <Border Style="{StaticResource CardBorder}" Padding="12">
        <StackPanel>
            <TextBlock Text="{Binding Properties.Text, FallbackValue=Комментарии}"
                       Style="{StaticResource Heading3Text}" Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CaptionText}"
                           Text="Комментарии загружаются на опубликованном сайте и в панели свойств." />
            </Border>
            <TextBox Height="36" IsReadOnly="True"
                     Tag="Поле ввода комментария (превью)" />
        </StackPanel>
    </Border>
</UserControl>
