<UserControl x:Class="CMSBuilder.Views.Elements.ContainerElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="80" MinWidth="140">
    <Border BorderBrush="{Binding Style.BorderColor, Converter={StaticResource CssBrush}, FallbackValue=#1B6B3A}"
            BorderThickness="{Binding Style.BorderWidth, Converter={StaticResource CssBorderThickness}, FallbackValue=1}"
            CornerRadius="8"
            Padding="8"
            ClipToBounds="True"
            Background="{Binding Style.BackgroundColor, Converter={StaticResource CssBrush}, FallbackValue=#EEF2F0}"
            AllowDrop="True"
            Drop="Container_Drop"
            DragOver="Container_DragOver">
        <Grid>
            <TextBlock Text="{Binding Properties.Text}"
                       Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,0,0,4"
                       IsHitTestVisible="False"
                       Visibility="{Binding Properties.Text, Converter={StaticResource StringToVis}}" />
            <Canvas MinHeight="48" Margin="0,18,0,0"
                    Width="{Binding Width, Converter={StaticResource NullableDoubleToSize}}"
                    Height="{Binding Height, Converter={StaticResource NullableDoubleToSize}, ConverterParameter=48}">
                <ItemsControl ItemsSource="{Binding Children}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="2" Background="Transparent"
                                    MouseLeftButtonDown="ChildElement_MouseLeftButtonDown"
                                    Cursor="SizeAll">
                                <ContentControl Content="{Binding Type, Converter={StaticResource ElementTypeToView}}"
                                                DataContext="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
