<UserControl x:Class="CMSBuilder.Views.Elements.HeaderElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock Text="{Binding Properties.Text}" Padding="8" FontWeight="SemiBold" MinWidth="60"
               FontFamily="{Binding Style.FontFamily}"
               FontSize="{Binding Style.FontSize, Converter={StaticResource CssFontSize}, FallbackValue=28}"
               Foreground="{Binding Style.Color, Converter={StaticResource CssBrush}}"
               Background="{Binding Style.BackgroundColor, Converter={StaticResource CssBrush}}" />
</UserControl>
