<UserControl x:Class="CMSBuilder.Views.Elements.TextAreaElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180" MinHeight="60">
    <TextBox Text="{Binding Properties.Placeholder, FallbackValue=Текст...}"
             IsReadOnly="True" Height="60" TextWrapping="Wrap"
             FontFamily="{Binding Style.FontFamily}"
             FontSize="{Binding Style.FontSize, Converter={StaticResource CssFontSize}}" />
</UserControl>
