<UserControl x:Class="CMSBuilder.Views.Elements.VideoEmbedElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200" MinHeight="120">
    <Border Background="#1A2420" CornerRadius="8" Padding="0">
        <Grid>
            <TextBlock Text="▶ Встроенное видео"
                       Foreground="#D4EBDC"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}" />
            <TextBlock Text="{Binding Properties.VideoUrl}"
                       Foreground="#8A9690"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"
                       Margin="8"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}" />
        </Grid>
    </Border>
</UserControl>
