<UserControl x:Class="CMSBuilder.Views.Elements.FormElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="100" MinWidth="200">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="8"
            ClipToBounds="True"
            Background="{Binding Style.BackgroundColor, Converter={StaticResource CssBrush}, FallbackValue=#F8FAF9}"
            AllowDrop="True"
            Drop="Container_Drop"
            DragOver="Container_DragOver">
        <Grid>
            <TextBlock Text="{Binding Properties.Text, FallbackValue=Форма}"
                       Style="{StaticResource Heading3Text}" Margin="0,0,0,4" IsHitTestVisible="False" />
            <Canvas Margin="0,22,0,0"
                    Width="{Binding Width, Converter={StaticResource NullableDoubleToSize}}"
                    Height="{Binding Height, Converter={StaticResource NullableDoubleToSize}, ConverterParameter=60}">
                <ItemsControl ItemsSource="{Binding Children}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="2" MouseLeftButtonDown="ChildElement_MouseLeftButtonDown" Cursor="SizeAll">
                                <ContentControl Content="{Binding Type, Converter={StaticResource ElementTypeToView}}"
                                                DataContext="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
