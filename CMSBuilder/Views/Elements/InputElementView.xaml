<UserControl x:Class="CMSBuilder.Views.Elements.InputElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <TextBox IsEnabled="False" Text="{Binding Properties.Placeholder, TargetNullValue=''}"
             FontFamily="{Binding Style.FontFamily}"
             FontSize="{Binding Style.FontSize, Converter={StaticResource CssFontSize}}" />
</UserControl>
