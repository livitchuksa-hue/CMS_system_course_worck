<UserControl x:Class="CMSBuilder.Views.Elements.TextElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock Text="{Binding Properties.Text}" Padding="8" MinWidth="40"
               FontFamily="{Binding Style.FontFamily}"
               FontSize="{Binding Style.FontSize, Converter={StaticResource CssFontSize}}"
               Foreground="{Binding Style.Color, Converter={StaticResource CssBrush}}"
               Background="{Binding Style.BackgroundColor, Converter={StaticResource CssBrush}}"
               TextAlignment="Left" />
</UserControl>
