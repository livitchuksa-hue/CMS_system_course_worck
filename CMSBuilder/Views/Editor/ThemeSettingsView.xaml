<UserControl x:Class="CMSBuilder.Views.Editor.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CMSBuilder.Helpers"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer Style="{StaticResource AppScrollViewer}" Padding="32">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Тема сайта"
                       Style="{StaticResource Heading1Text}"
                       Margin="0,0,0,8" />
            <TextBlock Text="Цвета и шрифты экспортируемого сайта"
                       Style="{StaticResource CaptionText}"
                       Margin="0,0,0,24" />

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                        <TextBlock Text="Primary color" Style="{StaticResource LabelText}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,10,0" />
                            <TextBox Width="120" Text="#1B6B3A" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Secondary color" Style="{StaticResource LabelText}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="#5C6B64"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,10,0" />
                            <TextBox Width="120" Text="#5C6B64" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                        <TextBlock Text="Accent color" Style="{StaticResource LabelText}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="#2E8B57"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,10,0" />
                            <TextBox Width="120" Text="#2E8B57" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Шрифт" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{x:Static helpers:ProjectFonts.All}"
                                  IsEditable="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,16">
                        <TextBlock Text="Button radius" Style="{StaticResource LabelText}" />
                        <TextBox Text="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Padding" Style="{StaticResource LabelText}" />
                        <TextBox Text="16" />
                    </StackPanel>

                    <Button Grid.Row="3" Grid.ColumnSpan="2"
                            Content="Сохранить тему"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            MinWidth="180" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
