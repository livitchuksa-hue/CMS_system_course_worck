<UserControl x:Class="CMSBuilder.Views.Editor.OrganizationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360">

    <Border Style="{StaticResource CardBorder}" Padding="16">
        <StackPanel>
            <TextBlock Text="Команда сайта"
                       Style="{StaticResource Heading2Text}"
                       Margin="0,0,0,12" />

            <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                <TextBlock Text="Логин пользователя" Style="{StaticResource LabelText}" />
                <TextBox Margin="0,0,0,8"
                         Text="{Binding InviteLogin, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Роль" Style="{StaticResource LabelText}" />
                <ComboBox Margin="0,0,0,12"
                          ItemsSource="{Binding InviteRoles}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedRoleCode}" />
                <Button Content="Пригласить"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding InviteCommand}" />
            </StackPanel>

            <TextBlock Text="Участники"
                       Style="{StaticResource SectionHeader}" />

            <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Login}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{Binding RoleName}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Удалить"
                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                        <Condition Binding="{Binding IsOwner}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Покинуть проект"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,0,8"
                    Visibility="{Binding CanLeave, Converter={StaticResource BoolToVis}}"
                    Command="{Binding LeaveCommand}" />

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
        </StackPanel>
    </Border>
</UserControl>
