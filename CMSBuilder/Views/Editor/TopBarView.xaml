<UserControl x:Class="CMSBuilder.Views.Editor.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:CMSBuilder.Views.Editor"
             Height="56"
             Background="{StaticResource SurfaceBrush}">

    <Grid>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Назад" Style="{StaticResource SecondaryButton}"
                        MinWidth="90" Margin="0,0,12,0" Command="{Binding BackCommand}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WebsiteName}" Style="{StaticResource Heading3Text}" />
                    <TextBlock Text="{Binding UserRole, StringFormat=Роль: {0}}" Style="{StaticResource CaptionText}" />
                </StackPanel>

                <editor:PageTabsView Grid.Column="2" VerticalAlignment="Center" Margin="16,0" DataContext="{Binding}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="Настройки" Style="{StaticResource SecondaryButton}"
                            MinWidth="100" Margin="0,0,8,0" Command="{Binding ToggleSettingsCommand}"
                            Visibility="{Binding CanChangeSettings, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="OrgButton" Content="Команда" Style="{StaticResource SecondaryButton}"
                            MinWidth="90" Margin="0,0,8,0" Command="{Binding ToggleOrganizationCommand}"
                            Visibility="{Binding CanManageTeam, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Запустить" Style="{StaticResource SecondaryButton}" MinWidth="100"
                            Margin="0,0,8,0" Command="{Binding LaunchSiteCommand}" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="110"
                            Margin="0,0,8,0" Command="{Binding SaveCommand}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="EditorProfileButton" Content="Аккаунт" Style="{StaticResource SecondaryButton}"
                            MinWidth="90" Command="{Binding OpenAccountCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Popup IsOpen="{Binding IsSettingsOpen}" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-200">
            <Border Style="{StaticResource CardBorder}" Padding="0" Background="{StaticResource BackgroundBrush}">
                <editor:WebsiteSettingsView DataContext="{Binding Settings}" />
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsOrganizationOpen}" PlacementTarget="{Binding ElementName=OrgButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-120">
            <editor:OrganizationPanelView DataContext="{Binding Organization}" />
        </Popup>

        <Popup IsOpen="{Binding Account.IsOpen}" PlacementTarget="{Binding ElementName=EditorProfileButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-80">
            <Border Style="{StaticResource CardBorder}" Padding="16" MinWidth="240">
                <StackPanel DataContext="{Binding Account}">
                    <TextBlock Text="Аккаунт" Style="{StaticResource Heading3Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentUserLogin, StringFormat=Логин: {0}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding CurrentUserEmail, StringFormat=Email: {0}}" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                    <Button Content="Выйти" Style="{StaticResource PrimaryButton}" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
