<UserControl x:Class="CMSBuilder.Views.Editor.SiteMembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Участники и роли"
                   Style="{StaticResource SectionHeader}" />

        <Border Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="admin@site" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="140" Margin="8,0">
                    <ComboBoxItem Content="Владелец" IsSelected="True" />
                </ComboBox>
                <Button Grid.Column="2" Content="×" Style="{StaticResource IconButton}" />
            </Grid>
        </Border>

        <Border Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="user@mail" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="140" Margin="8,0">
                    <ComboBoxItem Content="Модератор" IsSelected="True" />
                </ComboBox>
                <Button Grid.Column="2" Content="×" Style="{StaticResource IconButton}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
