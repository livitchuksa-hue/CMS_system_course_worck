<UserControl x:Class="CMSBuilder.Views.Editor.ElementActionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Действие" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="Тип" Style="{StaticResource LabelText}" />
        <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding ButtonActionType}" Margin="0,0,0,12" />

        <StackPanel Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ButtonActionType}" Value="NavigateToPage">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Страница" Style="{StaticResource LabelText}" />
            <ComboBox ItemsSource="{Binding PagesForAction}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding ButtonTargetPageId}" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ButtonActionType}" Value="OpenUrl">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="URL" Style="{StaticResource LabelText}" />
            <TextBox Text="{Binding ButtonTargetUrl, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ButtonActionType}" Value="SubmitForm">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Форма для отправки" Style="{StaticResource LabelText}" />
            <ComboBox ItemsSource="{Binding FormsOnPage}" DisplayMemberPath="Label"
                      SelectedValuePath="Id" SelectedValue="{Binding ButtonTargetElementId}" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ButtonActionType}" Value="CustomScript">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Свой JS (в script.js)" Style="{StaticResource LabelText}" />
            <TextBox Text="{Binding ButtonCustomJs, UpdateSourceTrigger=PropertyChanged}"
                     Height="80" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>

        <Button Content="Применить действие" Style="{StaticResource PrimaryButton}"
                Command="{Binding ApplyButtonActionCommand}" />
    </StackPanel>
</UserControl>
