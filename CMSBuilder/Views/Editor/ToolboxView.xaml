<UserControl x:Class="CMSBuilder.Views.Editor.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240"
             Background="{StaticResource SurfaceBrush}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
        <ScrollViewer Style="{StaticResource AppScrollViewer}">
            <StackPanel x:Name="ToolboxPanel">
                <TextBlock Text="Элементы" Style="{StaticResource Heading2Text}" Margin="0,0,0,16" />
                <TextBlock Text="Basic" Style="{StaticResource SectionHeader}" />
                <Button Tag="Text" Content="Text" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Header" Content="Header" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Image" Content="Image" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Divider" Content="Divider" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Container" Content="Container" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="VideoEmbed" Content="Video embed" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <TextBlock Text="Functional" Style="{StaticResource SectionHeader}" Margin="0,16,0,12" />
                <Button Tag="Button" Content="Button" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Input" Content="Input" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Form" Content="Form" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Checkbox" Content="Checkbox" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <TextBlock Text="Complex" Style="{StaticResource SectionHeader}" Margin="0,16,0,12" />
                <Button Tag="Navbar" Content="Navbar" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Footer" Content="Footer" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Gallery" Content="Gallery" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Slider" Content="Slider" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="FAQ" Content="FAQ" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="Card" Content="Card" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="VideoPlayer" Content="Video player" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="CommentsBlock" Content="Comments (add)" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
                <Button Tag="CommentsViewer" Content="Comments (view)" Style="{StaticResource ToolboxItemButton}" PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
