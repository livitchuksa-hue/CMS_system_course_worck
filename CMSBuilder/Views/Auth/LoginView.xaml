<UserControl x:Class="CMSBuilder.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CMSBuilder.Helpers"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AccentBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CMS Builder" FontSize="42" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Конструктор сайтов" Margin="0,10,0,0" FontSize="16" Foreground="#D4EBDC" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Style="{StaticResource CardBorder}" Width="400" Padding="32"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Вход" Style="{StaticResource Heading1Text}" Margin="0,0,0,8" />
                    <TextBlock Text="Войдите в аккаунт" Style="{StaticResource CaptionText}" Margin="0,0,0,24" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                    <TextBlock Text="Логин" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Пароль" Style="{StaticResource LabelText}" />
                    <PasswordBox Margin="0,0,0,12"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Запомнить меня" IsChecked="{Binding RememberMe}" Margin="0,0,0,16" />

                    <Button Content="Войти" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                            Command="{Binding LoginCommand}" />
                    <Button Content="Регистрация" Style="{StaticResource SecondaryButton}"
                            Command="{Binding GoRegisterCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
