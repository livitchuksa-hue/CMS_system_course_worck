<UserControl x:Class="CMSBuilder.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CMSBuilder.Helpers"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AccentBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CMS Builder" FontSize="42" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Создайте аккаунт" Margin="0,10,0,0" FontSize="16" Foreground="#D4EBDC" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource WorkspaceBrush}">
            <Border Style="{StaticResource CardBorder}" Width="400" Padding="32"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Регистрация" Style="{StaticResource Heading1Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" Margin="0,0,0,12" />

                    <TextBlock Text="Логин" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Email" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Пароль" Style="{StaticResource LabelText}" />
                    <PasswordBox Margin="0,0,0,12"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Подтверждение" Style="{StaticResource LabelText}" />
                    <PasswordBox Margin="0,0,0,20"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Создать аккаунт" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                            Command="{Binding RegisterCommand}" />
                    <Button Content="Уже есть аккаунт" Style="{StaticResource SecondaryButton}"
                            Command="{Binding GoLoginCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
