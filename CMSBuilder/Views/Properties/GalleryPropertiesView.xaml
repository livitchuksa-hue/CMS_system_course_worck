<UserControl x:Class="CMSBuilder.Views.Properties.GalleryPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Колонки" Style="{StaticResource LabelText}" />
        <TextBox Margin="0,0,0,14" Text="3" />

        <TextBlock Text="Отступ" Style="{StaticResource LabelText}" />
        <TextBox Margin="0,0,0,14" Text="12" />

        <TextBlock Text="Соотношение сторон" Style="{StaticResource LabelText}" />
        <ComboBox Margin="0,0,0,14">
            <ComboBoxItem Content="1:1" IsSelected="True" />
            <ComboBoxItem Content="4:3" />
            <ComboBoxItem Content="16:9" />
        </ComboBox>

        <Button Content="Добавить изображение"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>
