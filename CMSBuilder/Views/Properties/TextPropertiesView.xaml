<UserControl x:Class="CMSBuilder.Views.Properties.TextPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Текст" Style="{StaticResource LabelText}" />
        <TextBox Margin="0,0,0,14" Text="Заголовок страницы" />

        <TextBlock Text="Размер шрифта" Style="{StaticResource LabelText}" />
        <TextBox Margin="0,0,0,14" Text="24" />

        <TextBlock Text="Цвет" Style="{StaticResource LabelText}" />
        <TextBox Margin="0,0,0,14" Text="#1A2420" />

        <TextBlock Text="Выравнивание" Style="{StaticResource LabelText}" />
        <ComboBox Margin="0,0,0,14">
            <ComboBoxItem Content="Left" IsSelected="True" />
            <ComboBoxItem Content="Center" />
            <ComboBoxItem Content="Right" />
        </ComboBox>

        <TextBlock Text="Margin" Style="{StaticResource LabelText}" />
        <TextBox Text="0,0,0,0" />
    </StackPanel>
</UserControl>
