<UserControl x:Class="CMSBuilder.Views.Properties.InputPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Placeholder" Style="{StaticResource LabelText}" />
        <TextBox Text="{Binding Properties.Placeholder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
        <TextBlock Text="Тип" Style="{StaticResource LabelText}" />
        <TextBox Text="{Binding Properties.InputType, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
