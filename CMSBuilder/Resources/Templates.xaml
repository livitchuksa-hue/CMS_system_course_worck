<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Auth hero panel (left side) -->
    <DataTemplate x:Key="AuthHeroTemplate">
        <Border Background="{StaticResource AccentBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CMS Builder"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="Конструктор сайтов"
                           Margin="0,10,0,0"
                           FontSize="16"
                           Foreground="#D4EBDC"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Property field row -->
    <DataTemplate x:Key="PropertyFieldTemplate">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource LabelText}" Text="{Binding Label}" />
            <ContentPresenter Content="{Binding Editor}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
