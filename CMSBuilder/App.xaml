<Application x:Class="CMSBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CMSBuilder.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/Templates.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:ElementTypeToViewConverter x:Key="ElementTypeToView" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:CssFontSizeConverter x:Key="CssFontSize" />
            <conv:CssBrushConverter x:Key="CssBrush" />
            <conv:NullableDoubleConverter x:Key="NullableDouble" />
            <conv:NullableDoubleToSizeConverter x:Key="NullableDoubleToSize" />
            <conv:CssBorderThicknessConverter x:Key="CssBorderThickness" />
            <conv:PxStringConverter x:Key="PxString" />
            <conv:HexColorStringConverter x:Key="HexColorString" />
            <conv:PositiveDoubleConverter x:Key="PositiveDouble" />
            <conv:IntegerStringConverter x:Key="IntegerString" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
